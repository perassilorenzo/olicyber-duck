{
  "name": "oliduck",
  "version": "1.0.0",
  "private": true,
  "description": "OliDuck — assistente didattico per le Olimpiadi Italiane di Cybersicurezza",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --compatibility-date=2025-04-01",
    "deploy": "wrangler pages deploy public",
    "dataset:build": "node scripts/build-dataset.mjs",
    "dataset:import": "node scripts/import-dataset.mjs",
    "dataset:browser-import": "node scripts/import-browser-export.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "wrangler": "^4.0.0"
  }
}
